<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.maxqiu.test.mapper.UserMapper">

    <select id="countByAge" resultType="com.maxqiu.test.dto.AgeCount">
        SELECT age, COUNT(*) AS count
        FROM t_user
        GROUP BY age
        ORDER BY age
    </select>

</mapper>
